# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
TELEGRAM_BOT_NAME=
ALLOWED_TG_IDS=123456789

# Inference provider: lmstudio | openrouter
LLM_PROVIDER=lmstudio
# Failover between the two providers when both are configured: auto | off
LLM_FAILOVER=auto

# LM Studio (local, OpenAI-compatible server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.8-27b
LMSTUDIO_CONTEXT_LENGTH=42496

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_CONTEXT_LENGTH=131072

# Model output cap per request
LLM_MAX_TOKENS=2048
# Retry budget for a summary call truncated at the first attempt
# (finish_reason == "length"); 256-8192, tried exactly once, after which the
# turn proceeds without a summary rather than blocking the user.
LLM_SUMMARY_MAX_TOKENS=1536

# Network fetch tool
FETCH_ALLOWED_DOMAINS=wttr.in

# Optional
# Must satisfy LLM_TIMEOUT_S >= 21.1 + 0.093 * LLM_MAX_TOKENS (the measured
# latency model); load_config refuses a pair that would time out and retry a
# long completion with identical parameters, re-sending the whole prompt.
LLM_TIMEOUT_S=240
EXEC_WORKDIR=./sandbox
EXEC_DOCKER_IMAGE=python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6
DB_PATH=./bot.db
AUDIT_LOG_PATH=./exec_audit.jsonl
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_S=6
# Sandbox disk quota in bytes; exec refuses once the sandbox holds this much
EXEC_SANDBOX_MAX_BYTES=268435456
# Empty the sandbox directory automatically at startup (true/false); an
# operator who wants to keep files across restarts sets this to false
EXEC_SANDBOX_CLEAN_ON_START=true
# Inline window per exec stream, in characters, before the head/tail window
# and the duplicate collapse of REQ-V13-TOO-01 kick in (200-4096); the model
# can ask for less or more per call with the tool argument max_output_chars,
# within the same range.
EXEC_OUTPUT_DEFAULT_CHARS=1500
# Inline window for a fetch result, in characters (500-20000); the full text of
# a truncated fetch is saved under <EXEC_WORKDIR>/fetch/ instead.
FETCH_INLINE_DEFAULT_CHARS=5000
# Replace tool results of earlier turns with a short stub (tool, size, sha256
# prefix, first 120 characters) in the request only (on/off); the database, the
# audit trail and /summary always keep the full text.
HISTORY_TOOL_STUB=on
# Cost accounting (REQ-V13-PRC-02): prices are fetched once, at startup, from
# OpenRouter's public /models list.
# An OpenRouter model id whose list price is the reference price for local
# LM Studio calls (an estimate); empty leaves local calls unpriced.
LLM_PRICE_REF_MODEL=
# Manual USD per million tokens — the fallback when /models is unreachable.
# Both or neither; 0 is a valid (free) price.
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=
# Route /summary and the /new hand-off to a second model, as <provider>:<model>
# (lmstudio|openrouter, and that provider must be configured above); empty keeps
# the summary on the main client. No failover applies to the routed client.
LLM_SUMMARY_MODEL=

# Route the RAG rerank call (below) to a second model, exactly
# LLM_SUMMARY_MODEL's shape (<provider>:<model>, that provider must be
# configured above, no failover); empty keeps rerank on the main client.
# Recommended: the local LM Studio box has no non-thinking chat model --
# every chat model there burns its whole completion budget on reasoning
# before ever answering the rerank prompt (docs/reports/report-v1.9.1.md) --
# so rerank is routed to a small, fast, JSON-schema-capable model instead.
# v1.9.1 T3 (docs/spec/task-briefs/v191-T3.md): T1's google/gemma-3-12b-it
# is served by a single OpenRouter upstream that rate-limits a burst -- a
# 10-request burst measured 1/10 ok (9x HTTP 429), which is exactly what
# took gate 7 down. mistral-small-24b-instruct-2501 survived that same
# burst 10/10 and had the best measured recall (9/10) among the models
# that did.
LLM_RERANK_MODEL=openrouter:mistralai/mistral-small-24b-instruct-2501

# Reasoning policy (spec-v1.7.0): model-default | off | by-purpose. Only
# "by-purpose" reads LLM_REASONING_ON_PURPOSES below; the other two ignore it.
LLM_REASONING_POLICY=by-purpose
# LLM_REASONING_ON_PURPOSES: comma-separated, order-insensitive tags (tool-round | final | summary) that stay at the provider's default under by-purpose;
# LLM_REASONING_ON_PURPOSES's absence from this list asks that purpose to turn reasoning off instead. An empty value is legal and means none stay at the default.
LLM_REASONING_ON_PURPOSES=tool-round

# Observability (spec-v1.6.0): captures message/tool content on spans when
# true (true/false); off by default, content never leaves the process
# unless explicitly turned on.
OBS_CAPTURE_CONTENT=false
# The local dashboard (spec-v1.6.0): on by default, loopback-only, read-only.
# Either this or --no-dashboard turns it off; the flag wins when they disagree.
DASHBOARD_ENABLED=true
# 1024-65535; the bind address itself (127.0.0.1) is fixed and not configurable.
DASHBOARD_PORT=8765

# Retrieval over user documents (spec-v1.9.0). Both EMBEDDING_MODEL and
# EMBEDDING_DIM are optional at config level (unset means RAG is off, and
# every document is answered with a "not configured" line) but required
# together, and required at deployment: the live selftest (gate 5) fails
# without them.
# Base URL for the embeddings endpoint; empty resolves to LMSTUDIO_BASE_URL.
EMBEDDING_BASE_URL=
# The embedding model id, as loaded by the embeddings server.
EMBEDDING_MODEL=
# The embedding vector's dimension (1-4096), matching EMBEDDING_MODEL.
EMBEDDING_DIM=
# Per-request timeout for the embeddings endpoint, in seconds (0-600].
EMBEDDING_TIMEOUT_S=60
# Passages returned to the model per query (1-10).
RAG_TOP_K=5
# LLM listwise reranking of retrieved passages: on | off.
RAG_RERANK=on
